# ==============================================================================
# InsightBolivia — Streamlit Secrets Template
# ==============================================================================
# Copiar este archivo como secrets.toml y completar con valores reales.
# NUNCA comitear secrets.toml al repositorio.
# ==============================================================================

# --- Google Cloud Platform (BigQuery & Cloud Firestore) ---
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""

# --- Cloud Firestore Database ---
[firestore]
database = "(default)"

