# ==============================================================================
# InsightBolivia — Streamlit Secrets Template
# ==============================================================================
# Copiar este archivo como secrets.toml dentro de .streamlit/ y completar con valores reales.
# NUNCA comitear secrets.toml al repositorio de control de versiones.
# ==============================================================================

# --- Google Cloud Platform Service Account (BigQuery & Cloud Firestore) ---
[gcp_service_account]
type = "service_account"
project_id = "insight-bolivia"
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "streamlit-sa@insight-bolivia.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""

# --- Google BigQuery Configuration ---
[bigquery]
project_id = "insight-bolivia"
dataset = "comercio_exterior"
location = "US"

# --- Cloud Firestore Database Configuration ---
[firestore]
database = "(default)"
project_id = "insight-bolivia"
