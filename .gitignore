# ==============================================================================
# InsightBolivia - Comprehensive & Secure .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Credentials & Environment Variables (CRITICAL - CERO SECRETO)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.test.example
*.env
*.pem
*.key
*.p12
*.crt

# GCP Service Account Keys & Secrets JSON
*service_account*.json
*service-account*.json
*gcp_key*.json
*gcp-key*.json
*credentials*.json
secrets.json
.gcp/

# Supabase Credentials & Local State
.supabase/
supabase/.temp/

# Streamlit Secrets
.streamlit/secrets.toml
streamlit_app/.streamlit/secrets.toml
secrets.toml

# ------------------------------------------------------------------------------
# Data Files & Storage (Evitar comitear datasets pesados o crudos)
# ------------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/staging/*
!data/staging/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/downloads/*
!data/downloads/.gitkeep

# Exclusión general de formatos de datos masivos (excepto test fixtures)
*.xlsx
*.xls
*.csv
*.dbf
*.parquet
*.feather
*.zip
*.tar.gz
*.gz

# Permitir explícitamente fixtures sintéticos de pruebas
!tests/fixtures/*.xlsx
!tests/fixtures/*.csv
!tests/fixtures/*.dbf

# ------------------------------------------------------------------------------
# Great Expectations (GX) - Data Docs no comiteados y estado local
# ------------------------------------------------------------------------------
gx/uncommitted/
gx/plugins/
gx/expectations/uncommitted_*

# ------------------------------------------------------------------------------
# Python, Entornos Virtuales y Gestor uv
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Entornos virtuales
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Herramientas de Test, Cobertura y Linter (Pytest, Ruff, Mypy)
# ------------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py.cover
.hypothesis/
.tox/
.nox/
.cache
.mypy_cache/
.dmypy.json
dmypy.json

# ------------------------------------------------------------------------------
# Jupyter Notebooks & Interactive Python
# ------------------------------------------------------------------------------
.ipynb_checkpoints
profile_default/
ipython_config.py

# ------------------------------------------------------------------------------
# IDEs, Editores y Asistentes IA (VS Code, PyCharm, Antigravity)
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
tempCodeRunnerFile.py

# Local state de agentes/herramientas IA
.brain/
.gemini/
.antigravity/

# ------------------------------------------------------------------------------
# Archivos de Sistema Operativo
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
