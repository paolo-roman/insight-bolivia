# ==============================================================================
# InsightBolivia — Variables de Entorno
# ==============================================================================
# Copiar este archivo como .env y completar con valores reales.
# NUNCA comitear .env al repositorio (está en .gitignore).
#
# En CI/CD (GitHub Actions), estas variables se inyectan como GitHub Secrets.
# En Streamlit Cloud, se configuran en st.secrets (panel de administración).
# ==============================================================================

# --- Google Cloud Platform ---
GCP_PROJECT_ID=insightbolivia-dwh
GCP_SA_KEY_PATH=path/to/service-account-key.json

# --- BigQuery ---
BQ_PROJECT_ID=insightbolivia-dwh
BQ_DATASET=comercio_exterior
BQ_DATASET_STAGING=staging
BQ_DATASET_OPERATIONS=operations
BQ_LOCATION=US

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Pipeline ETL ---
INE_BASE_URL=https://www.ine.gob.bo
LOG_LEVEL=INFO

# --- Alertas y Notificaciones (Opcional) ---
DISCORD_WEBHOOK_URL=
ALERT_EMAIL=
